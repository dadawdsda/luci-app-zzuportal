#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT

USE_PROCD=1
START=99
STOP=10

PROGRAM="/usr/bin/zzuportal"
AUTH_FAILURE_MARKER="/tmp/zzuportal-auth-failure"

start_service() {
	local service_enabled

	rm -f "$AUTH_FAILURE_MARKER"
	config_load zzuportal
	config_get_bool service_enabled main enabled 0
	[ "$service_enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROGRAM" --loop
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 10
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger zzuportal
}
